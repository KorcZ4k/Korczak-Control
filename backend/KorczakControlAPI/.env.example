NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000,http://10.0.2.2:3000
# Sempre use pelo menos 32 caracteres aleatórios.
JWT_SECRET=replace-with-a-long-random-secret-before-running
# Necessário para persistência de usuários.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE
# Obrigatório somente para criar o primeiro Owner em produção.
BOOTSTRAP_TOKEN=replace-with-a-separate-random-bootstrap-token
# Reservados para integrações futuras. Nunca colocar valores reais no Git.
GITHUB_TOKEN=
RENDER_API_KEY=
