# Ambiente
NODE_ENV=development
PORT=3000
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_COM_NO_MINIMO_32_CARACTERES
BOOTSTRAP_TOKEN=SUBSTITUA_POR_UM_TOKEN_DE_USO_UNICO
CORS_ORIGIN=

# MongoDB - conexões por banco de dados
# Se os bancos estiverem no mesmo cluster, as URIs podem ser iguais.
ADMIN_DB_URI=
TENSURA_DB_URI=
KZSITE_DB_URI=

# Banco que contém a collection administrativa Admin.
# Por padrão, usa KorczakTechSite para evitar criar um banco chamado Admin.
ADMIN_DB_NAME=KorczakTechSite
ADMIN_COLLECTION_NAME=Admin

# Outros bancos
TENSURA_DB_NAME=MoonTensura
KZSITE_DB_NAME=KorczakTechSite

# Integrações administrativas
GITHUB_TOKEN=
RENDER_API_KEY=
