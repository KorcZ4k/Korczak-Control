NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3000,http://10.0.2.2:3000
# Em produção, use um segredo aleatório com pelo menos 32 caracteres.
JWT_SECRET=replace-with-a-long-random-secret-before-production
# Necessário para registro/login persistente.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE
# Reservados para integrações futuras. Nunca colocar valores reais no Git.
GITHUB_TOKEN=
RENDER_API_KEY=
